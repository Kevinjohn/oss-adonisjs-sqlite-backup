{
  "name": "@kevinjohn/adonisjs-sqlite-backup",
  "description": "Verified SQLite backup bundles and prepare-only restore for AdonisJS 7 Lucid apps",
  "version": "0.2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "!win32"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests",
    "CHANGELOG.md"
  ],
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands": "./build/commands/main.js",
    "./sqlite_backup_provider": "./build/providers/sqlite_backup_provider.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "check:changed": "node --import=@poppinss/ts-exec --enable-source-maps bin/check_changed.ts",
    "precompile": "pnpm lint",
    "compile": "tsdown && tsc --emitDeclarationOnly --declaration && node -e \"require('node:fs').cpSync('stubs','build/stubs',{recursive:true,filter:(s)=>!s.endsWith('.ts')})\"",
    "build": "pnpm compile"
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**",
      "bin/**",
      "src/types.ts"
    ],
    "all": true,
    "include": [
      "index.ts",
      "configure.ts",
      "providers/**/*.ts",
      "commands/**/*.ts",
      "src/**/*.ts"
    ],
    "check-coverage": true,
    "statements": 100,
    "lines": 100,
    "branches": 95,
    "functions": 100
  },
  "keywords": [
    "adonisjs",
    "adonisjs-lucid",
    "sqlite",
    "backup",
    "better-sqlite3"
  ],
  "author": "Kevinjohn Gallagher",
  "license": "MIT",
  "homepage": "https://github.com/Kevinjohn/oss-adonisjs-sqlite-backup#readme",
  "bugs": {
    "url": "https://github.com/Kevinjohn/oss-adonisjs-sqlite-backup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kevinjohn/oss-adonisjs-sqlite-backup.git"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/core": "^7.0.1",
    "@adonisjs/eslint-config": "^3.0.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/prettier-config": "^1.4.5",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/expect-type": "^2.0.4",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.5.1",
    "@types/luxon": "^3.0.0",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^13.0.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "luxon": "^3.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.23.4",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "better-sqlite3": "^13.0.0"
  },
  "tsdown": {
    "entry": [
      "./index.ts",
      "./configure.ts",
      "./src/types.ts",
      "./commands/main.ts",
      "./commands/db_backup.ts",
      "./commands/db_upgrade.ts",
      "./stubs/main.ts",
      "./providers/sqlite_backup_provider.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "minify": "dce-only",
    "fixedExtension": false,
    "dts": false,
    "treeshake": false,
    "sourcemaps": false,
    "target": "esnext"
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@11.23.0"
}
